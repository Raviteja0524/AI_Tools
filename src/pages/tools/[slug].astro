---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import IndiaTag from '@/components/ui/IndiaTag.astro';
import { tools, getRelatedTools, getCategoryById } from '@/utils/tools';
import { toolSeoTitle, toolSeoDescription, buildSchemaForTool, buildBreadcrumbSchema, SITE_URL } from '@/utils/seo';
import type { Tool } from '@/utils/tools';

export function getStaticPaths() {
  return tools.map(tool => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props as { tool: Tool };
const related = getRelatedTools(tool, 4);
const category = getCategoryById(tool.category);
const affiliateUrl = tool.affiliateUrl ?? tool.url;

const toolSchema = buildSchemaForTool({
  ...tool,
  logo: tool.logo,
});
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home',  url: SITE_URL },
  { name: 'Tools', url: `${SITE_URL}/tools` },
  ...(category ? [{ name: category.name, url: `${SITE_URL}/tools?category=${category.id}` }] : []),
  { name: tool.name, url: `${SITE_URL}/tools/${tool.slug}` },
]);

// Derive star display
const fullStars = Math.floor(tool.rating);
const hasHalf = tool.rating % 1 >= 0.5;
const emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);

// Top 3 highlights from pros
const highlights = tool.pros.slice(0, 3);

// Pricing display
const PRICING_COLOR = {
  free: { bg: '#22C55E12', border: '#22C55E30', text: '#22C55E', label: 'Free' },
  freemium: { bg: '#F59E0B12', border: '#F59E0B30', text: '#F59E0B', label: 'Freemium' },
  paid: { bg: '#EF444412', border: '#EF444430', text: '#EF4444', label: 'Paid' },
};
const pricingStyle = PRICING_COLOR[tool.pricing];

// Use-case tags (human-readable)
const TAG_LABELS: Record<string, string> = {
  students: 'Students',
  'india-popular': 'India Popular',
  coding: 'Coding',
  writing: 'Writing',
  research: 'Research',
  offline: 'Offline Use',
  local: 'Runs Locally',
  free: 'Free',
  'free-for-students': 'Free for Students',
  'open-source': 'Open Source',
  privacy: 'Privacy-First',
  education: 'Education',
  design: 'Design',
  'image-gen': 'Image Generation',
  'voice': 'Voice',
  'audio': 'Audio',
  'music': 'Music',
  'transcription': 'Transcription',
  'pdf': 'PDF Analysis',
  freelancers: 'Freelancers',
  affordable: 'Affordable',
};
---

<BaseLayout
  title={toolSeoTitle(tool.name)}
  description={toolSeoDescription(tool)}
  ogType="article"
  schema={[toolSchema, breadcrumbSchema]}
>
  <!-- Mobile sticky CTA (renders at bottom of viewport) -->
  <div class="mobile-sticky-cta" aria-hidden="true">
    <a
      href={affiliateUrl}
      target="_blank"
      rel="noopener noreferrer nofollow sponsored"
      class="mobile-sticky-btn"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Visit {tool.name}
    </a>
    {tool.indianPricing && (
      <span class="mobile-sticky-price">{tool.indianPricing}</span>
    )}
  </div>

  <div class="tool-detail">
    <!-- ── Breadcrumb ─────────────────────────────────── -->
    <div class="container-site">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/tools">Tools</a>
        {category && <>
          <span aria-hidden="true">›</span>
          <a href={`/tools?category=${category.id}`}>{category.name}</a>
        </>}
        <span aria-hidden="true">›</span>
        <span aria-current="page">{tool.name}</span>
      </nav>
    </div>

    <!-- ── Hero ──────────────────────────────────────── -->
    <div class="hero-band">
      <div class="hero-band-bg" aria-hidden="true">
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
      </div>
      <div class="container-site">
        <div class="hero-layout">
          <!-- Left: identity block -->
          <div class="hero-identity">
            <div class="hero-logo-wrap">
              <img
                src={tool.logo}
                alt={`${tool.name} logo`}
                width="80"
                height="80"
                class="hero-logo"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
              />
              <div class="hero-logo-fallback" aria-hidden="true">
                {tool.name.charAt(0)}
              </div>
            </div>

            <div class="hero-text">
              <div class="hero-badges">
                {tool.pricing === 'free' && <Badge variant="free">🆓 Free</Badge>}
                {tool.pricing === 'freemium' && <Badge variant="freemium">⚡ Freemium</Badge>}
                {tool.pricing === 'paid' && <Badge variant="paid">💰 Paid</Badge>}
                {tool.freeForever && <Badge variant="free">♾️ Free Forever</Badge>}
                {tool.bestForIndia && <IndiaTag />}
                {tool.featured && <Badge variant="new">⭐ Featured</Badge>}
              </div>
              <h1 class="hero-name">{tool.name}</h1>
              <p class="hero-tagline">{tool.tagline}</p>

              <!-- Rating row -->
              <div class="hero-rating" aria-label={`Rating: ${tool.rating} out of 5`}>
                <span class="stars" aria-hidden="true">
                  {'★'.repeat(fullStars)}{hasHalf ? '⯨' : ''}{'☆'.repeat(emptyStars)}
                </span>
                <strong class="rating-num">{tool.rating}</strong>
                <span class="rating-slash">/5</span>
                {tool.reviewCount && (
                  <span class="rating-count">
                    ({tool.reviewCount.toLocaleString('en-IN')} reviews)
                  </span>
                )}
              </div>
            </div>
          </div>

          <!-- Right: CTA block -->
          <div class="hero-cta-block">
            <a
              href={affiliateUrl}
              target="_blank"
              rel="noopener noreferrer nofollow sponsored"
              class="hero-visit-btn"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Visit {tool.name}
            </a>
            {tool.indianPricing && (
              <div class="hero-price-tag">
                <span class="hero-price-label">India pricing</span>
                <span class="hero-price-val">{tool.indianPricing}</span>
              </div>
            )}
            <a href={tool.url} target="_blank" rel="noopener noreferrer" class="hero-official-link">
              Official website ↗
            </a>
          </div>
        </div>

        <!-- Stats strip -->
        <div class="hero-stats" role="list">
          <div class="hero-stat" role="listitem">
            <span class="hero-stat-label">Category</span>
            <a href={`/tools?category=${tool.category}`} class="hero-stat-val hero-stat-link">
              {category?.icon} {category?.name ?? tool.category}
            </a>
          </div>
          <div class="hero-stat-sep" aria-hidden="true"></div>
          <div class="hero-stat" role="listitem">
            <span class="hero-stat-label">Pricing</span>
            <span class="hero-stat-val" style={`color: ${pricingStyle.text}`}>
              {pricingStyle.label}
            </span>
          </div>
          {tool.bestForIndia && <>
            <div class="hero-stat-sep" aria-hidden="true"></div>
            <div class="hero-stat" role="listitem">
              <span class="hero-stat-label">India</span>
              <span class="hero-stat-val" style="color: #F59E0B">🇮🇳 Recommended</span>
            </div>
          </>}
          {tool.freeForever && <>
            <div class="hero-stat-sep" aria-hidden="true"></div>
            <div class="hero-stat" role="listitem">
              <span class="hero-stat-label">Cost</span>
              <span class="hero-stat-val" style="color: #22C55E">♾️ Free forever</span>
            </div>
          </>}
          {tool.languages && tool.languages.length > 0 && <>
            <div class="hero-stat-sep" aria-hidden="true"></div>
            <div class="hero-stat" role="listitem">
              <span class="hero-stat-label">Languages</span>
              <span class="hero-stat-val">{tool.languages.length}+ supported</span>
            </div>
          </>}
        </div>
      </div>
    </div>

    <!-- ── Body ──────────────────────────────────────── -->
    <div class="container-site">
      <div class="body-grid">

        <!-- ── MAIN COLUMN ─────────────────────────── -->
        <main class="main-col">

          <!-- About -->
          <section class="content-section" aria-labelledby="about-heading">
            <h2 id="about-heading" class="section-heading">
              About {tool.name}
            </h2>
            <p class="body-text">{tool.description}</p>
          </section>

          <!-- Key highlights (from pros) -->
          <section class="content-section" aria-labelledby="highlights-heading">
            <h2 id="highlights-heading" class="section-heading">Key Highlights</h2>
            <ul class="highlights-grid" role="list">
              {highlights.map((h, i) => (
                <li class="highlight-card">
                  <span class="highlight-num" aria-hidden="true">0{i + 1}</span>
                  <p class="highlight-text">{h}</p>
                </li>
              ))}
            </ul>
          </section>

          <!-- Pros & Cons -->
          <section class="content-section" aria-labelledby="proscons-heading">
            <h2 id="proscons-heading" class="section-heading">Pros &amp; Cons</h2>
            <div class="pros-cons">
              <div class="pros-block">
                <div class="pc-header pc-header-pro">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2 7l3.5 3.5L12 3" stroke="#22C55E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  Pros
                </div>
                <ul class="pc-list">
                  {tool.pros.map(p => (
                    <li class="pc-item pc-item-pro">
                      <span class="pc-dot" aria-hidden="true"></span>
                      {p}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="cons-block">
                <div class="pc-header pc-header-con">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2.5 2.5l9 9M11.5 2.5l-9 9" stroke="#F59E0B" stroke-width="1.75" stroke-linecap="round"/>
                  </svg>
                  Cons
                </div>
                <ul class="pc-list">
                  {tool.cons.map(c => (
                    <li class="pc-item pc-item-con">
                      <span class="pc-dot" aria-hidden="true"></span>
                      {c}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>

          <!-- India Spotlight (conditional) -->
          {tool.bestForIndia && (
            <section class="content-section india-spotlight" aria-labelledby="india-heading">
              <div class="india-spotlight-inner">
                <div class="india-spotlight-icon" aria-hidden="true">🇮🇳</div>
                <div>
                  <h2 id="india-heading" class="section-heading" style="margin-bottom: 0.5rem;">
                    Why It's Great for India
                  </h2>
                  <p class="body-text" style="margin-bottom: 0.875rem;">
                    {tool.name} earns its India Recommended badge for a reason. Here's why Indian
                    developers, students, and freelancers love it:
                  </p>
                  <ul class="india-list">
                    {tool.indianPricing && (
                      <li>
                        <strong>Affordable pricing</strong> — {tool.indianPricing} vs. expensive USD plans
                      </li>
                    )}
                    {tool.freeForever && (
                      <li>
                        <strong>Completely free</strong> — no credit card, no hidden costs, no trial expiry
                      </li>
                    )}
                    {tool.languages && tool.languages.some(l => l !== 'English') && (
                      <li>
                        <strong>Indian language support</strong> — works in{' '}
                        {tool.languages.filter(l => l !== 'English').join(', ')}
                      </li>
                    )}
                    {tool.tags.includes('offline') && (
                      <li>
                        <strong>Works offline</strong> — no dependency on fast internet; runs locally on your machine
                      </li>
                    )}
                    {tool.tags.includes('students') && (
                      <li>
                        <strong>Student-friendly</strong> — widely used across Indian colleges for assignments, research, and projects
                      </li>
                    )}
                  </ul>
                </div>
              </div>
            </section>
          )}

          <!-- Pricing details -->
          <section class="content-section" aria-labelledby="pricing-heading">
            <h2 id="pricing-heading" class="section-heading">Pricing</h2>
            <div class="pricing-card" style={`border-color: ${pricingStyle.border}; background: ${pricingStyle.bg}`}>
              <div class="pricing-card-header">
                <span class="pricing-type-badge" style={`color: ${pricingStyle.text}; border-color: ${pricingStyle.border}; background: ${pricingStyle.bg}`}>
                  {pricingStyle.label}
                </span>
                {tool.freeForever && (
                  <span class="pricing-forever-badge">♾️ No credit card ever</span>
                )}
              </div>
              {tool.indianPricing ? (
                <p class="pricing-inr">
                  <span class="pricing-inr-label">India:</span>
                  <strong class="pricing-inr-val">{tool.indianPricing}</strong>
                </p>
              ) : (
                <p class="body-text" style="margin: 0;">
                  Check the official site for current pricing in your region.
                </p>
              )}
              <a
                href={affiliateUrl}
                target="_blank"
                rel="noopener noreferrer nofollow sponsored"
                class="pricing-visit-link"
              >
                See full pricing on {tool.name} ↗
              </a>
            </div>
          </section>

          <!-- Supported languages -->
          {tool.languages && tool.languages.length > 0 && (
            <section class="content-section" aria-labelledby="languages-heading">
              <h2 id="languages-heading" class="section-heading">Supported Languages</h2>
              <div class="chip-list">
                {tool.languages.map(lang => (
                  <span class="lang-chip">{lang}</span>
                ))}
              </div>
            </section>
          )}

          <!-- Use cases / Tags -->
          <section class="content-section" aria-labelledby="usecases-heading">
            <h2 id="usecases-heading" class="section-heading">Use Cases &amp; Tags</h2>
            <div class="chip-list">
              {tool.tags.map(tag => (
                <a href={`/tools?filter=${tag}`} class="tag-chip">
                  {TAG_LABELS[tag] ?? tag}
                </a>
              ))}
            </div>
          </section>
        </main>

        <!-- ── SIDEBAR ──────────────────────────────── -->
        <aside class="sidebar-col">
          <!-- Sticky CTA card -->
          <div class="sidebar-cta-card">
            <a
              href={affiliateUrl}
              target="_blank"
              rel="noopener noreferrer nofollow sponsored"
              class="sidebar-visit-btn"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Visit {tool.name}
            </a>
            {tool.indianPricing && (
              <p class="sidebar-cta-price">{tool.indianPricing}</p>
            )}
            <p class="sidebar-cta-note">Opens official site — affiliate link may apply</p>
          </div>

          <!-- Quick info -->
          <div class="sidebar-info-card">
            <h3 class="sidebar-card-title">Quick Info</h3>
            <dl class="info-dl">
              <div class="info-row">
                <dt>Category</dt>
                <dd>
                  <a href={`/tools?category=${tool.category}`} class="info-link">
                    {category?.icon} {category?.name ?? tool.category}
                  </a>
                </dd>
              </div>
              <div class="info-row">
                <dt>Pricing</dt>
                <dd style={`color: ${pricingStyle.text}`}>{pricingStyle.label}</dd>
              </div>
              {tool.indianPricing && (
                <div class="info-row">
                  <dt>India cost</dt>
                  <dd>{tool.indianPricing}</dd>
                </div>
              )}
              <div class="info-row">
                <dt>India rating</dt>
                <dd>{tool.bestForIndia ? '🇮🇳 Recommended' : '—'}</dd>
              </div>
              <div class="info-row">
                <dt>Free forever</dt>
                <dd>{tool.freeForever ? '✅ Yes' : 'No'}</dd>
              </div>
              <div class="info-row">
                <dt>Works offline</dt>
                <dd>{tool.tags.includes('offline') ? '✅ Yes' : 'No'}</dd>
              </div>
              <div class="info-row">
                <dt>Rating</dt>
                <dd>
                  <span aria-label={`${tool.rating} out of 5`}>
                    {tool.rating} ★
                    {tool.reviewCount && <span class="info-review-ct">({tool.reviewCount.toLocaleString('en-IN')})</span>}
                  </span>
                </dd>
              </div>
              <div class="info-row">
                <dt>Listed</dt>
                <dd>{new Date(tool.dateAdded).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' })}</dd>
              </div>
            </dl>
          </div>

          <!-- Related tools -->
          {related.length > 0 && (
            <div class="sidebar-related-card">
              <h3 class="sidebar-card-title">Similar Tools</h3>
              <ul class="related-list" role="list">
                {related.map(r => (
                  <li>
                    <a href={`/tools/${r.slug}`} class="related-row">
                      <div class="related-logo-wrap">
                        <img
                          src={r.logo}
                          alt=""
                          width="28"
                          height="28"
                          class="related-logo"
                          onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                        />
                        <div class="related-logo-fallback" aria-hidden="true">{r.name.charAt(0)}</div>
                      </div>
                      <div class="related-info">
                        <span class="related-name">{r.name}</span>
                        <span class="related-tagline">{r.tagline.slice(0, 48)}{r.tagline.length > 48 ? '…' : ''}</span>
                      </div>
                      <span class="related-rating">{r.rating}★</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a href={`/tools?category=${tool.category}`} class="related-see-all">
                See all {category?.name} tools →
              </a>
            </div>
          )}
        </aside>
      </div>

      <!-- ── Related tools full grid ──────────────── -->
      {related.length > 0 && (
        <section class="related-section" aria-labelledby="related-heading">
          <div class="related-header">
            <h2 id="related-heading" class="section-heading" style="margin-bottom: 0">
              More {category?.name} Tools
            </h2>
            <a href={`/tools?category=${tool.category}`} class="related-all-link">
              Browse all →
            </a>
          </div>
          <ul class="related-grid" role="list">
            {related.map(r => (
              <li>
                <a href={`/tools/${r.slug}`} class="rg-card">
                  <div class="rg-header">
                    <div class="rg-logo-wrap">
                      <img
                        src={r.logo}
                        alt=""
                        width="40"
                        height="40"
                        class="rg-logo"
                        onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                      />
                      <div class="rg-logo-fallback" aria-hidden="true">{r.name.charAt(0)}</div>
                    </div>
                    <div class="rg-meta">
                      <span class="rg-name">{r.name}</span>
                      <div class="rg-badges">
                        {r.pricing === 'free' && <span class="rg-badge rg-free">Free</span>}
                        {r.pricing === 'freemium' && <span class="rg-badge rg-freemium">Freemium</span>}
                        {r.pricing === 'paid' && <span class="rg-badge rg-paid">Paid</span>}
                        {r.bestForIndia && <span class="rg-badge rg-india">🇮🇳</span>}
                      </div>
                    </div>
                    <span class="rg-rating">{r.rating}★</span>
                  </div>
                  <p class="rg-tagline">{r.tagline}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- ── Bottom CTA banner ─────────────────────── -->
      <div class="bottom-cta">
        <div class="bottom-cta-glow" aria-hidden="true"></div>
        <div class="bottom-cta-content">
          <div>
            <p class="bottom-cta-eyebrow">Ready to try it?</p>
            <h2 class="bottom-cta-title">Get started with {tool.name}</h2>
            <p class="bottom-cta-sub">
              {tool.freeForever
                ? 'Completely free — no credit card, no trial, no catch.'
                : tool.pricing === 'freemium'
                  ? 'Start for free. Upgrade only if you need more.'
                  : 'Visit the official site to see current pricing.'}
            </p>
          </div>
          <div class="bottom-cta-actions">
            <a
              href={affiliateUrl}
              target="_blank"
              rel="noopener noreferrer nofollow sponsored"
              class="bottom-cta-btn-primary"
            >
              Visit {tool.name} ↗
            </a>
            <a href="/tools" class="bottom-cta-btn-ghost">
              ← Browse more tools
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Layout ─────────────────────────────────────── */
  .tool-detail {
    padding-bottom: 5rem;
  }

  /* ── Breadcrumb ─────────────────────────────────── */
  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem 0.5rem;
    font-size: 0.8125rem;
    color: #52525B;
    padding: 1.5rem 0 0;
  }
  .breadcrumb a {
    color: #71717A;
    text-decoration: none;
    transition: color 0.15s;
  }
  .breadcrumb a:hover { color: #A1A1AA; }

  /* ── Hero band ──────────────────────────────────── */
  .hero-band {
    position: relative;
    margin-top: 1.25rem;
    padding: 2.5rem 0 0;
    overflow: hidden;
  }
  .hero-band-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
  }
  .hero-orb-1 {
    width: 500px;
    height: 300px;
    background: #7C3AED;
    opacity: 0.12;
    top: -80px;
    left: -100px;
  }
  .hero-orb-2 {
    width: 350px;
    height: 200px;
    background: #06B6D4;
    opacity: 0.07;
    top: 0;
    right: -50px;
  }

  .hero-layout {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-identity {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    flex: 1;
    min-width: 0;
  }
  .hero-logo-wrap {
    width: 80px;
    height: 80px;
    border-radius: 18px;
    border: 1px solid #2D2D3E;
    background: #17171F;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-logo { width: 100%; height: 100%; object-fit: contain; }
  .hero-logo-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
