---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatted = new Date(post.data.datePublished).toLocaleDateString('en-IN', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.datePublished,
  dateModified: post.data.dateModified ?? post.data.datePublished,
  author: { '@type': 'Organization', name: 'AI Tools India', url: 'https://bestaitools.in' },
  publisher: {
    '@type': 'Organization',
    name: 'AI Tools India',
    url: 'https://bestaitools.in',
    logo: { '@type': 'ImageObject', url: 'https://bestaitools.in/favicon.svg' },
  },
  mainEntityOfPage: `https://bestaitools.in/blog/${post.id}`,
  keywords: post.data.tags?.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bestaitools.in' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://bestaitools.in/blog' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: `https://bestaitools.in/blog/${post.id}` },
  ],
};
---

<BaseLayout
  title={`${post.data.title} | AI Tools India`}
  description={post.data.description}
  schema={[articleSchema, breadcrumbSchema]}
  ogType="article"
  canonicalUrl={`https://bestaitools.in/blog/${post.id}`}
>
  <div class="blog-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb container-site" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/blog">Blog</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{post.data.title}</span>
    </nav>

    <!-- Post header -->
    <header class="post-header">
      <div class="container-site">
        <div class="post-header-inner">
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map(tag => (
                <span class="post-tag">#{tag}</span>
              ))}
            </div>
          )}
          <h1 class="post-title">{post.data.title}</h1>
          <p class="post-desc">{post.data.description}</p>
          <div class="post-meta">
            <div class="author-chip">
              <div class="author-avatar" aria-hidden="true">AI</div>
              <div>
                <div class="author-name">AI Tools India</div>
                <div class="author-role">Editorial Team</div>
              </div>
            </div>
            <div class="meta-right">
              <time class="post-date" datetime={post.data.datePublished}>{dateFormatted}</time>
              {post.data.readingTime && (
                <span class="read-time">· {post.data.readingTime}</span>
              )}
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Content -->
    <div class="blog-body container-site">
      <article class="post-article prose-content" data-pagefind-body>
        <Content />
      </article>

      <!-- Post footer -->
      <footer class="post-footer">
        <div class="footer-divider"></div>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="footer-tags">
            <span class="footer-tags-label">Tagged:</span>
            {post.data.tags.map(tag => (
              <span class="footer-tag">#{tag}</span>
            ))}
          </div>
        )}
        <div class="footer-nav">
          <a href="/blog" class="footer-nav-link">← Back to Blog</a>
          <a href="/tools" class="footer-nav-link">Browse All Tools →</a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>

<style>
  .blog-page { padding-bottom: 6rem; }

  /* Breadcrumb */
  .breadcrumb {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 1.25rem 1rem; font-size: 0.75rem; color: #52525B;
  }
  .breadcrumb a { color: #71717A; text-decoration: none; transition: color 0.15s; }
  .breadcrumb a:hover { color: #A1A1AA; }
  .breadcrumb span[aria-current] { color: #A1A1AA; }

  /* Header */
  .post-header {
    border-bottom: 1px solid #1F1F2E;
    background: linear-gradient(180deg, #0D0D14 0%, #09090B 100%);
    padding: 2.5rem 0 2rem; margin-bottom: 3rem;
  }
  .post-header-inner { max-width: 72ch; }
  .post-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .post-tag {
    font-size: 0.6875rem; font-weight: 600; color: #06B6D4;
    background: #06B6D410; border: 1px solid #06B6D430;
    padding: 0.2rem 0.625rem; border-radius: 100px;
  }
  .post-title { margin: 0 0 0.875rem; font-size: clamp(1.5rem, 3.5vw, 2.125rem); line-height: 1.2; }
  .post-desc { color: #71717A; font-size: 1rem; line-height: 1.6; margin: 0 0 1.5rem; }
  .post-meta { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  .author-chip { display: flex; align-items: center; gap: 0.75rem; }
  .author-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(135deg, #7C3AED, #06B6D4);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.625rem; font-weight: 800; color: #fff;
    flex-shrink: 0;
  }
  .author-name { font-size: 0.875rem; font-weight: 600; color: #E4E4E7; }
  .author-role { font-size: 0.6875rem; color: #52525B; }
  .meta-right { display: flex; align-items: center; gap: 0.375rem; }
  .post-date { font-size: 0.8125rem; color: #71717A; }
  .read-time { font-size: 0.8125rem; color: #52525B; }

  /* Content */
  .blog-body { padding: 0 1rem; }
  .post-article { max-width: 72ch; }

  /* Prose */
  .prose-content { color: #A1A1AA; line-height: 1.8; font-size: 0.9375rem; }
  .prose-content :global(h2) {
    font-size: 1.375rem; font-weight: 700; color: #F8F8F8;
    margin: 2.5rem 0 1rem; padding-top: 0.5rem; border-top: 1px solid #1F1F2E;
  }
  .prose-content :global(h3) { font-size: 1.0625rem; font-weight: 700; color: #F8F8F8; margin: 2rem 0 0.75rem; }
  .prose-content :global(h4) { font-size: 0.9375rem; font-weight: 700; color: #E4E4E7; margin: 1.5rem 0 0.5rem; }
  .prose-content :global(p) { margin: 0 0 1.25rem; }
  .prose-content :global(a) { color: #7C3AED; text-decoration: underline; text-underline-offset: 3px; }
  .prose-content :global(a:hover) { color: #9D5CF0; }
  .prose-content :global(strong) { color: #F8F8F8; font-weight: 600; }
  .prose-content :global(em) { color: #E4E4E7; }
  .prose-content :global(code) {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.8125rem; background: #111116; color: #06B6D4;
    padding: 0.15rem 0.4rem; border-radius: 4px; border: 1px solid #1F1F2E;
  }
  .prose-content :global(pre) {
    background: #0D0D14; border: 1px solid #1F1F2E; border-radius: 10px;
    padding: 1.25rem 1.5rem; overflow-x: auto; margin: 1.5rem 0;
  }
  .prose-content :global(pre code) {
    background: none; border: none; padding: 0; color: #E4E4E7; font-size: 0.8125rem; line-height: 1.7;
  }
  .prose-content :global(ul), .prose-content :global(ol) { padding-left: 1.5rem; margin: 0 0 1.25rem; }
  .prose-content :global(li) { margin-bottom: 0.5rem; }
  .prose-content :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.875rem; }
  .prose-content :global(th) {
    background: #111116; color: #E4E4E7; font-weight: 600; font-size: 0.75rem;
    text-transform: uppercase; letter-spacing: 0.04em;
    padding: 0.625rem 0.875rem; border: 1px solid #1F1F2E; text-align: left;
  }
  .prose-content :global(td) { padding: 0.625rem 0.875rem; border: 1px solid #1F1F2E; color: #A1A1AA; vertical-align: top; }
  .prose-content :global(tr:hover td) { background: #111116; }
  .prose-content :global(blockquote) {
    border-left: 3px solid #06B6D4; margin: 1.5rem 0;
    padding: 0.875rem 1.25rem; background: #06B6D408; border-radius: 0 8px 8px 0;
  }
  .prose-content :global(hr) { border: none; border-top: 1px solid #1F1F2E; margin: 2.5rem 0; }

  /* Post footer */
  .post-footer { max-width: 72ch; margin-top: 4rem; }
  .footer-divider { border-top: 1px solid #1F1F2E; margin-bottom: 1.5rem; }
  .footer-tags { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .footer-tags-label { font-size: 0.75rem; color: #52525B; }
  .footer-tag { font-size: 0.75rem; color: #71717A; }
  .footer-nav { display: flex; justify-content: space-between; }
  .footer-nav-link {
    font-size: 0.875rem; color: #7C3AED; text-decoration: none;
    transition: color 0.15s;
  }
  .footer-nav-link:hover { color: #9D5CF0; }
</style>
