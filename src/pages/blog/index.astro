---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime();
});

const upcomingPosts = [
  { title: 'Why Local LLMs Are a Game-Changer for Indian Developers', tag: 'Opinion' },
  { title: 'AI Tools That Actually Work in Hindi — Tested List', tag: 'Languages' },
  { title: 'How Indian Developers Are Using AI to 10× Productivity', tag: 'Productivity' },
  { title: 'GPT-4 vs Claude vs Gemini — India Benchmark Test 2026', tag: 'Comparison' },
];
---

<BaseLayout
  title="AI Tools Blog — News, Tips & Insights for India 2026 | AI Tools"
  description="The latest AI tool news, tips, and insights for Indian developers, students, and freelancers. Model comparisons, productivity guides, and India-specific coverage."
>
  <div class="content-page">
    <div class="container-site">
      <header class="page-header">
        <div class="page-eyebrow">Blog</div>
        <h1>AI Tools Blog</h1>
        <p class="page-desc">
          News, comparisons, and insights about AI tools — from an Indian perspective.
          No hype, no filler. Just useful signal.
        </p>
      </header>

      {posts.length > 0 && (
        <section class="posts-section">
          <div class="section-label">
            {posts.length} {posts.length === 1 ? 'article' : 'articles'} published
          </div>
          <ul class="posts-grid" role="list">
            {posts.map((post, i) => {
              const dateStr = new Date(post.data.datePublished).toLocaleDateString('en-IN', {
                year: 'numeric', month: 'short', day: 'numeric',
              });
              const isFeatured = i === 0 && post.data.featured;
              return (
                <li class={isFeatured ? 'post-featured-wrap' : ''}>
                  <a href={`/blog/${post.id}`} class={`post-card ${isFeatured ? 'post-card-featured' : ''}`}>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="pc-tags">
                        {post.data.tags.slice(0, 3).map(tag => (
                          <span class="pc-tag">#{tag}</span>
                        ))}
                      </div>
                    )}
                    <h2 class="pc-title">{post.data.title}</h2>
                    <p class="pc-desc">{post.data.description}</p>
                    <div class="pc-footer">
                      <time class="pc-date" datetime={post.data.datePublished}>{dateStr}</time>
                      {post.data.readingTime && (
                        <span class="pc-read-time">· {post.data.readingTime}</span>
                      )}
                      <span class="pc-read-more">Read →</span>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      <section class="upcoming-section">
        <div class="section-label">Coming up</div>
        <ul class="upcoming-list" role="list">
          {upcomingPosts.map(p => (
            <li class="upcoming-item">
              <div>
                <span class="upcoming-tag">{p.tag}</span>
                <div class="upcoming-title">{p.title}</div>
              </div>
              <div class="upcoming-status">Coming soon</div>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .content-page { padding: 3rem 0 6rem; }
  .page-header { max-width: 600px; margin-bottom: 3rem; }
  .page-eyebrow { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #F59E0B; margin-bottom: 0.75rem; }
  .page-header h1 { margin: 0 0 0.875rem; }
  .page-desc { color: #A1A1AA; font-size: 1rem; line-height: 1.65; margin: 0; }

  .section-label { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #52525B; margin-bottom: 1rem; }
  .posts-section { margin-bottom: 3.5rem; }

  .posts-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1rem; }
  .post-featured-wrap { grid-column: 1 / -1; }
  @media (max-width: 480px) { .posts-grid { grid-template-columns: 1fr; } }

  .post-card {
    display: flex; flex-direction: column; gap: 0.75rem;
    padding: 1.375rem; border-radius: 14px;
    border: 1px solid #1F1F2E; background: #111116;
    text-decoration: none; transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
    height: 100%;
  }
  .post-card:hover { border-color: #F59E0B40; transform: translateY(-2px); box-shadow: 0 8px 30px #F59E0B08; }
  .post-card-featured { background: linear-gradient(135deg, #111116, #0D0A0A); }
  .post-card-featured .pc-title { font-size: 1.25rem; }

  .pc-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .pc-tag {
    font-size: 0.6875rem; font-weight: 600; color: #F59E0B;
    background: #F59E0B10; border: 1px solid #F59E0B25;
    padding: 0.2rem 0.5rem; border-radius: 100px;
  }
  .pc-title { font-size: 1rem; font-weight: 700; color: #F8F8F8; line-height: 1.35; margin: 0; }
  .pc-desc { font-size: 0.8125rem; color: #71717A; line-height: 1.55; margin: 0; flex: 1; }
  .pc-footer {
    display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
    padding-top: 0.5rem; border-top: 1px solid #1A1A24; margin-top: auto;
  }
  .pc-date { font-size: 0.6875rem; color: #52525B; }
  .pc-read-time { font-size: 0.6875rem; color: #52525B; }
  .pc-read-more { font-size: 0.6875rem; font-weight: 600; color: #F59E0B; margin-left: auto; }

  /* Upcoming */
  .upcoming-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
  .upcoming-item {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 1rem 0; border-bottom: 1px solid #1A1A24;
  }
  .upcoming-item:last-child { border-bottom: none; }
  .upcoming-tag { font-size: 0.6875rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 999px; background: #F59E0B15; color: #F59E0B; border: 1px solid #F59E0B30; display: inline-block; margin-bottom: 0.375rem; }
  .upcoming-title { font-size: 0.875rem; color: #71717A; line-height: 1.4; }
  .upcoming-status { font-size: 0.6875rem; color: #3F3F46; flex-shrink: 0; }
  @media (max-width: 480px) { .upcoming-status { display: none; } }
</style>
