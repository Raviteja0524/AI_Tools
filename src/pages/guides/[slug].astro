---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map(guide => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);

const DIFFICULTY_CONFIG = {
  beginner:     { label: 'Beginner',     color: '#22C55E', bg: '#22C55E15', border: '#22C55E30' },
  intermediate: { label: 'Intermediate', color: '#F59E0B', bg: '#F59E0B15', border: '#F59E0B30' },
  advanced:     { label: 'Advanced',     color: '#EF4444', bg: '#EF444415', border: '#EF444430' },
};
const diff = DIFFICULTY_CONFIG[guide.data.difficulty];

const dateFormatted = new Date(guide.data.datePublished).toLocaleDateString('en-IN', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const tocHeadings = headings.filter(h => h.depth === 2);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.datePublished,
  dateModified: guide.data.dateModified ?? guide.data.datePublished,
  author: { '@type': 'Organization', name: 'AI Tools India' },
  publisher: {
    '@type': 'Organization',
    name: 'AI Tools India',
    url: 'https://bestaitools.in',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bestaitools.in' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://bestaitools.in/guides' },
    { '@type': 'ListItem', position: 3, name: guide.data.title, item: `https://bestaitools.in/guides/${guide.id}` },
  ],
};
---

<BaseLayout
  title={`${guide.data.title} | AI Tools India`}
  description={guide.data.description}
  schema={[articleSchema, breadcrumbSchema]}
  canonicalUrl={`https://bestaitools.in/guides/${guide.id}`}
>
  <div class="guide-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb container-site" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/guides">Guides</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{guide.data.title}</span>
    </nav>

    <!-- Header -->
    <header class="guide-header">
      <div class="container-site">
        <div class="header-badges">
          <span
            class="diff-badge"
            style={`color: ${diff.color}; background: ${diff.bg}; border-color: ${diff.border}`}
          >
            {diff.label}
          </span>
          <span class="time-badge">⏱ {guide.data.timeToRead}</span>
          {guide.data.featured && <span class="featured-badge">Featured</span>}
        </div>
        <h1 class="guide-title">{guide.data.title}</h1>
        <p class="guide-desc">{guide.data.description}</p>
        <div class="guide-meta">
          <span>AI Tools India</span>
          <span class="meta-dot" aria-hidden="true">·</span>
          <time datetime={guide.data.datePublished}>{dateFormatted}</time>
          {guide.data.tags && guide.data.tags.length > 0 && (
            <>
              <span class="meta-dot" aria-hidden="true">·</span>
              {guide.data.tags.map(tag => (
                <span class="meta-tag">#{tag}</span>
              ))}
            </>
          )}
        </div>
      </div>
    </header>

    <!-- Body -->
    <div class="guide-body container-site">
      <div class={`guide-layout ${tocHeadings.length > 0 ? 'has-toc' : 'no-toc'}`}>
        <!-- Main content -->
        <main class="guide-main prose-content" data-pagefind-body>
          <Content />
        </main>

        <!-- Table of Contents (desktop only) -->
        {tocHeadings.length > 0 && (
          <aside class="toc-sidebar">
            <div class="toc-card">
              <div class="toc-title">In this guide</div>
              <nav aria-label="Table of contents">
                <ol class="toc-list">
                  {tocHeadings.map((h, i) => (
                    <li class="toc-item">
                      <a href={`#${h.slug}`} class="toc-link">
                        <span class="toc-num">{(i + 1).toString().padStart(2, '0')}</span>
                        <span class="toc-text">{h.text}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </div>
            <a href="/guides" class="toc-back">← All Guides</a>
          </aside>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .guide-page { padding-bottom: 6rem; }

  /* Breadcrumb */
  .breadcrumb {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 1.25rem 1rem; font-size: 0.75rem; color: #52525B;
  }
  .breadcrumb a { color: #71717A; text-decoration: none; transition: color 0.15s; }
  .breadcrumb a:hover { color: #A1A1AA; }
  .breadcrumb span[aria-current] { color: #A1A1AA; }

  /* Header */
  .guide-header {
    border-bottom: 1px solid #1F1F2E;
    background: linear-gradient(180deg, #0D0D14 0%, #09090B 100%);
    padding: 2.5rem 0 2rem; margin-bottom: 3rem;
  }
  .header-badges { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; }
  .diff-badge {
    font-size: 0.6875rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; padding: 0.2rem 0.625rem; border-radius: 100px; border: 1px solid;
  }
  .time-badge {
    font-size: 0.75rem; color: #71717A; background: #111116;
    border: 1px solid #1F1F2E; padding: 0.2rem 0.625rem; border-radius: 100px;
  }
  .featured-badge {
    font-size: 0.625rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; padding: 0.15rem 0.5rem; border-radius: 100px;
    background: #7C3AED20; color: #7C3AED; border: 1px solid #7C3AED40;
  }
  .guide-title { margin: 0 0 0.875rem; font-size: clamp(1.5rem, 3.5vw, 2rem); line-height: 1.2; }
  .guide-desc { color: #71717A; font-size: 1rem; line-height: 1.6; margin: 0 0 1rem; max-width: 68ch; }
  .guide-meta { display: flex; align-items: center; gap: 0.625rem; font-size: 0.75rem; color: #52525B; flex-wrap: wrap; }
  .meta-dot { color: #3F3F46; }
  .meta-tag { color: #7C3AED; }

  /* Layout */
  .guide-body { padding: 0 1rem; }
  .guide-layout { display: grid; gap: 3rem; align-items: start; }
  .has-toc { grid-template-columns: 1fr 260px; }
  .no-toc { grid-template-columns: 1fr; max-width: 72ch; }
  @media (max-width: 900px) {
    .has-toc { grid-template-columns: 1fr; }
    .toc-sidebar { display: none; }
  }

  /* Prose — shared with reviews page */
  .prose-content { color: #A1A1AA; line-height: 1.75; font-size: 0.9375rem; }
  .prose-content :global(h2) {
    font-size: 1.375rem; font-weight: 700; color: #F8F8F8;
    margin: 2.5rem 0 1rem; padding-top: 0.5rem; border-top: 1px solid #1F1F2E;
  }
  .prose-content :global(h3) { font-size: 1.0625rem; font-weight: 700; color: #F8F8F8; margin: 2rem 0 0.75rem; }
  .prose-content :global(h4) { font-size: 0.9375rem; font-weight: 700; color: #E4E4E7; margin: 1.5rem 0 0.5rem; }
  .prose-content :global(p) { margin: 0 0 1.125rem; }
  .prose-content :global(a) { color: #7C3AED; text-decoration: underline; text-underline-offset: 3px; }
  .prose-content :global(a:hover) { color: #9D5CF0; }
  .prose-content :global(strong) { color: #F8F8F8; font-weight: 600; }
  .prose-content :global(code) {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.8125rem; background: #111116; color: #06B6D4;
    padding: 0.15rem 0.4rem; border-radius: 4px; border: 1px solid #1F1F2E;
  }
  .prose-content :global(pre) {
    background: #0D0D14; border: 1px solid #1F1F2E; border-radius: 10px;
    padding: 1.25rem 1.5rem; overflow-x: auto; margin: 1.5rem 0;
  }
  .prose-content :global(pre code) {
    background: none; border: none; padding: 0; color: #E4E4E7; font-size: 0.8125rem; line-height: 1.7;
  }
  .prose-content :global(ul), .prose-content :global(ol) { padding-left: 1.5rem; margin: 0 0 1.125rem; }
  .prose-content :global(li) { margin-bottom: 0.375rem; }
  .prose-content :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.875rem; }
  .prose-content :global(th) {
    background: #111116; color: #E4E4E7; font-weight: 600; font-size: 0.75rem;
    text-transform: uppercase; letter-spacing: 0.04em;
    padding: 0.625rem 0.875rem; border: 1px solid #1F1F2E; text-align: left;
  }
  .prose-content :global(td) { padding: 0.625rem 0.875rem; border: 1px solid #1F1F2E; color: #A1A1AA; vertical-align: top; }
  .prose-content :global(tr:hover td) { background: #111116; }
  .prose-content :global(blockquote) {
    border-left: 3px solid #06B6D4; margin: 1.5rem 0;
    padding: 0.875rem 1.25rem; background: #06B6D408; border-radius: 0 8px 8px 0;
  }
  .prose-content :global(hr) { border: none; border-top: 1px solid #1F1F2E; margin: 2.5rem 0; }

  /* TOC */
  .toc-sidebar { position: sticky; top: 5rem; }
  .toc-card { padding: 1.125rem; border-radius: 12px; border: 1px solid #1F1F2E; background: #111116; margin-bottom: 0.75rem; }
  .toc-title {
    font-size: 0.6875rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.07em; color: #52525B; margin-bottom: 1rem;
  }
  .toc-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.125rem; }
  .toc-item {}
  .toc-link {
    display: flex; align-items: baseline; gap: 0.625rem;
    padding: 0.4rem 0.5rem; border-radius: 6px;
    text-decoration: none; transition: background 0.15s;
    font-size: 0.8125rem;
  }
  .toc-link:hover { background: #17171F; }
  .toc-num { font-size: 0.625rem; color: #3F3F46; font-weight: 700; flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .toc-text { color: #71717A; line-height: 1.4; transition: color 0.15s; }
  .toc-link:hover .toc-text { color: #A1A1AA; }
  .toc-back {
    display: block; font-size: 0.75rem; color: #52525B; text-decoration: none;
    text-align: center; padding: 0.375rem; transition: color 0.15s;
  }
  .toc-back:hover { color: #A1A1AA; }
</style>
