---
import BaseLayout from '@/components/layout/BaseLayout.astro';
---
<BaseLayout title="About — AI Tools India" description="About AI Tools — India's best AI tools directory for developers, students, and freelancers.">
  <div class="container-site" style="padding: 4rem 0 6rem; max-width: 720px; margin: 0 auto;">
    <h1>About AI Tools</h1>
    <p style="color: #A1A1AA; font-size: 1.0625rem; line-height: 1.7; margin-top: 1rem;">
      AI Tools is India's most comprehensive directory of AI tools for developers, students, and freelancers.
      Built by a Full-Stack AI Engineer who got tired of paying for tools that weren't worth it, or missing out on
      great free tools because no one had curated them for India.
    </p>
    <p style="color: #A1A1AA; font-size: 1.0625rem; line-height: 1.7; margin-top: 1rem;">
      Every tool here is tested. Ratings are honest. India-specific pricing is real — not converted from USD.
      If a tool costs ₹1,700/month, that's what we list, not a vague "starts at $20/month."
    </p>
    <h2 style="margin-top: 2.5rem;">Contact</h2>
    <p style="color: #A1A1AA;">
      Have a tool to suggest or want to collaborate?
      <a href="mailto:ravitejaamancha@luciddatahub.com" style="color: #7C3AED;">Send a message</a>.
    </p>
  </div>
</BaseLayout>
