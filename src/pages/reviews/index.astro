---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { getToolBySlug } from '@/utils/tools';

const allReviews = await getCollection('reviews');
const reviews = allReviews.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime();
});

const PRICING_COLOR: Record<string, string> = {
  free: '#22C55E',
  freemium: '#F59E0B',
  paid: '#EF4444',
};

const upcomingReviews = [
  { toolName: 'Cursor', tag: 'Coding' },
  { toolName: 'Perplexity AI', tag: 'Research' },
  { toolName: 'Midjourney', tag: 'Image Gen' },
  { toolName: 'GitHub Copilot', tag: 'Coding' },
  { toolName: 'NotebookLM', tag: 'Study' },
  { toolName: 'Codeium', tag: 'Coding' },
];
---

<BaseLayout
  title="AI Tool Reviews for India 2026 — Honest, In-Depth Analysis | AI Tools"
  description="In-depth AI tool reviews written for Indian developers, students, and freelancers. Real pricing in INR, honest pros and cons, no sponsored fluff."
>
  <div class="content-page">
    <div class="container-site">
      <header class="page-header">
        <div class="page-eyebrow">Reviews</div>
        <h1>Honest AI Tool Reviews</h1>
        <p class="page-desc">
          In-depth reviews written for Indian users — real pricing in ₹, tested use cases,
          and no paid placements. New reviews published weekly.
        </p>
      </header>

      {reviews.length > 0 ? (
        <section class="reviews-section">
          <div class="section-label">
            {reviews.length} {reviews.length === 1 ? 'review' : 'reviews'} published
          </div>
          <ul class="reviews-grid" role="list">
            {reviews.map(review => {
              const tool = getToolBySlug(review.data.toolSlug);
              const color = PRICING_COLOR[review.data.pricingTier] ?? '#A1A1AA';
              const ratingFull = Math.floor(review.data.rating);
              const dateStr = new Date(review.data.datePublished).toLocaleDateString('en-IN', {
                year: 'numeric', month: 'short', day: 'numeric',
              });
              return (
                <li>
                  <a href={`/reviews/${review.id}`} class="review-card">
                    <div class="rc-header">
                      <div class="rc-logo-wrap">
                        {tool ? (
                          <>
                            <img src={tool.logo} alt="" width="44" height="44" class="rc-logo" loading="lazy"
                              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                            <div class="rc-logo-fallback" aria-hidden="true">{review.data.toolName.charAt(0)}</div>
                          </>
                        ) : (
                          <div class="rc-logo-fallback" style="display:flex" aria-hidden="true">{review.data.toolName.charAt(0)}</div>
                        )}
                      </div>
                      <div class="rc-tool-info">
                        <div class="rc-tool-name">{review.data.toolName}</div>
                        <div class="rc-stars" aria-label={`${review.data.rating} out of 5`}>
                          {Array.from({ length: 5 }, (_, i) => (
                            <span class={i < ratingFull ? 'rc-star-on' : 'rc-star-off'}>★</span>
                          ))}
                          <span class="rc-rating-val">{review.data.rating}</span>
                        </div>
                      </div>
                      <span class="rc-pricing" style={`color: ${color}; border-color: ${color}30; background: ${color}10`}>
                        {review.data.pricingTier}
                      </span>
                    </div>
                    <h2 class="rc-title">{review.data.title}</h2>
                    <p class="rc-verdict">"{review.data.verdict}"</p>
                    <div class="rc-footer">
                      <time class="rc-date" datetime={review.data.datePublished}>{dateStr}</time>
                      {review.data.indianPricing && (
                        <span class="rc-inr">🇮🇳 {review.data.indianPricing}</span>
                      )}
                      {review.data.featured && <span class="rc-featured">Featured</span>}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ) : null}

      <section class="upcoming-section">
        <div class="section-label">Up next — reviews in progress</div>
        <ul class="upcoming-grid" role="list">
          {upcomingReviews.map(u => (
            <li class="upcoming-item">
              <span class="upcoming-tag">{u.tag}</span>
              <span class="upcoming-name">{u.toolName}</span>
              <span class="upcoming-status">Coming soon</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .content-page { padding: 3rem 0 6rem; }
  .page-header { max-width: 600px; margin-bottom: 3rem; }
  .page-eyebrow { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #7C3AED; margin-bottom: 0.75rem; }
  .page-header h1 { margin: 0 0 0.875rem; }
  .page-desc { color: #A1A1AA; font-size: 1rem; line-height: 1.65; margin: 0; }

  .section-label { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #52525B; margin-bottom: 1rem; }
  .reviews-section { margin-bottom: 3.5rem; }

  .reviews-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1rem; }
  @media (max-width: 480px) { .reviews-grid { grid-template-columns: 1fr; } }

  .review-card {
    display: flex; flex-direction: column; gap: 0.875rem;
    padding: 1.375rem; border-radius: 14px;
    border: 1px solid #1F1F2E; background: #111116;
    text-decoration: none; transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
  }
  .review-card:hover { border-color: #7C3AED40; transform: translateY(-2px); box-shadow: 0 8px 30px #7C3AED10; }

  .rc-header { display: flex; align-items: center; gap: 0.75rem; }
  .rc-logo-wrap {
    width: 48px; height: 48px; border-radius: 10px; border: 1px solid #2D2D3E;
    background: #17171F; overflow: hidden; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .rc-logo { width: 100%; height: 100%; object-fit: contain; }
  .rc-logo-fallback {
    width: 100%; height: 100%; display: none; align-items: center; justify-content: center;
    font-size: 1.125rem; font-weight: 800; color: #7C3AED; background: #7C3AED15;
  }
  .rc-tool-info { flex: 1; min-width: 0; }
  .rc-tool-name { font-size: 0.9375rem; font-weight: 700; color: #F8F8F8; }
  .rc-stars { display: flex; align-items: center; gap: 0.1rem; margin-top: 0.2rem; }
  .rc-star-on { color: #F59E0B; font-size: 0.75rem; }
  .rc-star-off { color: #3F3F46; font-size: 0.75rem; }
  .rc-rating-val { font-size: 0.6875rem; font-weight: 700; color: #F59E0B; margin-left: 0.25rem; }
  .rc-pricing {
    font-size: 0.6rem; font-weight: 700; text-transform: capitalize;
    padding: 0.2rem 0.5rem; border-radius: 100px; border: 1px solid; flex-shrink: 0;
  }

  .rc-title { font-size: 0.9375rem; font-weight: 600; color: #E4E4E7; line-height: 1.4; margin: 0; }
  .rc-verdict { font-size: 0.8125rem; color: #71717A; font-style: italic; line-height: 1.5; margin: 0; }
  .rc-footer { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; padding-top: 0.375rem; border-top: 1px solid #1A1A24; }
  .rc-date { font-size: 0.6875rem; color: #52525B; }
  .rc-inr { font-size: 0.6875rem; color: #A1A1AA; }
  .rc-featured { font-size: 0.5625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #7C3AED; background: #7C3AED15; border: 1px solid #7C3AED30; padding: 0.15rem 0.5rem; border-radius: 100px; }

  /* Upcoming */
  .upcoming-section {}
  .upcoming-grid { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
  .upcoming-item {
    display: grid; grid-template-columns: auto 1fr auto;
    align-items: center; gap: 1rem; padding: 0.875rem 0; border-bottom: 1px solid #1A1A24;
  }
  .upcoming-item:last-child { border-bottom: none; }
  .upcoming-tag { font-size: 0.6875rem; font-weight: 600; padding: 0.2rem 0.625rem; border-radius: 999px; background: #7C3AED15; color: #7C3AED; border: 1px solid #7C3AED30; white-space: nowrap; }
  .upcoming-name { font-size: 0.875rem; color: #71717A; }
  .upcoming-status { font-size: 0.6875rem; color: #3F3F46; white-space: nowrap; }
  @media (max-width: 480px) { .upcoming-item { grid-template-columns: auto 1fr; } .upcoming-status { display: none; } }
</style>
