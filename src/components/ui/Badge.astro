---
interface Props {
  variant?: 'free' | 'freemium' | 'paid' | 'new' | 'india' | 'default';
  size?: 'sm' | 'md';
  class?: string;
}
const { variant = 'default', size = 'md', class: className = '' } = Astro.props;
const variantClass = variant === 'default' ? 'badge-default' : `badge-${variant}`;
const sizeClass = size === 'sm' ? 'badge-sm' : '';
---
<span class:list={['badge', variantClass, sizeClass, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.2rem 0.625rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    white-space: nowrap;
    line-height: 1.4;
  }
  .badge-sm { font-size: 0.625rem; padding: 0.125rem 0.5rem; }

  .badge-default { background: #1F1F2E; color: #A1A1AA; border: 1px solid #2D2D3E; }
  .badge-free    { background: #22C55E15; color: #22C55E; border: 1px solid #22C55E30; }
  .badge-freemium{ background: #F59E0B15; color: #F59E0B; border: 1px solid #F59E0B30; }
  .badge-paid    { background: #EF444415; color: #EF4444; border: 1px solid #EF444430; }
  .badge-new     { background: #7C3AED20; color: #C4B5FD; border: 1px solid #7C3AED40; }
  .badge-india   {
    background: linear-gradient(135deg, #FF671F15, #04662015);
    color: #F59E0B;
    border: 1px solid #F59E0B30;
  }
</style>
