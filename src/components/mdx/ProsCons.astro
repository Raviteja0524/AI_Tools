---
interface Props {
  pros: string[];
  cons: string[];
}
const { pros, cons } = Astro.props;
---

<div class="pc-grid">
  <div class="pc-col pc-pros">
    <div class="pc-head">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2 7l3.5 3.5L12 3" stroke="#22C55E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Pros
    </div>
    <ul>
      {pros.map(p => <li>{p}</li>)}
    </ul>
  </div>
  <div class="pc-col pc-cons">
    <div class="pc-head">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2.5 2.5l9 9M11.5 2.5l-9 9" stroke="#F59E0B" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
      Cons
    </div>
    <ul>
      {cons.map(c => <li>{c}</li>)}
    </ul>
  </div>
</div>

<style>
  .pc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  @media (max-width: 540px) { .pc-grid { grid-template-columns: 1fr; } }
  .pc-col { padding: 1.125rem; border-radius: 12px; border: 1px solid; }
  .pc-pros { border-color: #22C55E25; background: #22C55E08; }
  .pc-cons { border-color: #F59E0B25; background: #F59E0B08; }
  .pc-head {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; margin-bottom: 0.875rem;
  }
  .pc-pros .pc-head { color: #22C55E; }
  .pc-cons .pc-head { color: #F59E0B; }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  li {
    font-size: 0.875rem; color: #A1A1AA; padding-left: 1rem;
    position: relative; line-height: 1.5;
  }
  .pc-pros li::before { content: '✓'; position: absolute; left: 0; color: #22C55E; font-weight: 700; }
  .pc-cons li::before { content: '×'; position: absolute; left: 0; color: #F59E0B; font-weight: 700; }
</style>
