---
const currentYear = new Date().getFullYear();

const categories = [
  { href: '/tools?category=writing-productivity', label: 'Writing & Productivity' },
  { href: '/tools?category=coding-assistants', label: 'AI Coding Assistants' },
  { href: '/tools?category=image-video', label: 'Image & Video' },
  { href: '/tools?category=local-llms', label: 'Local LLMs' },
  { href: '/tools?category=research-data', label: 'Research & Data' },
  { href: '/tools?category=audio-voice', label: 'Audio & Voice' },
];

const resources = [
  { href: '/guides', label: 'Guides' },
  { href: '/reviews', label: 'Reviews' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];

const filters = [
  { href: '/tools?filter=free', label: '🆓 Free Tools' },
  { href: '/tools?filter=india', label: '🇮🇳 India Favorites' },
  { href: '/tools?filter=offline', label: '📴 Works Offline' },
  { href: '/tools?filter=new', label: '🆕 Newly Added' },
];
---

<footer class="site-footer">
  <div class="footer-glow" aria-hidden="true"></div>
  <hr class="divider-glow" />

  <div class="container-site">
    <!-- Main footer grid -->
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="AI Tools Home">
          <div class="footer-logo-mark" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 28 28" fill="none">
              <defs>
                <linearGradient id="footer-logo-grad" x1="0" y1="0" x2="28" y2="28" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#9D65F5"/>
                  <stop offset="100%" stop-color="#06B6D4"/>
                </linearGradient>
              </defs>
              <path d="M14 2L26 8V20L14 26L2 20V8L14 2Z" stroke="url(#footer-logo-grad)" stroke-width="1.5" fill="none"/>
              <circle cx="14" cy="14" r="3" fill="url(#footer-logo-grad)"/>
            </svg>
          </div>
          <span class="footer-logo-name">AI Tools</span>
        </a>
        <p class="footer-desc">
          India's best directory of free and affordable AI tools for developers, students, and freelancers. Honest reviews. No fluff.
        </p>
        <div class="footer-badges">
          <span class="footer-badge">🇮🇳 Made for India</span>
          <span class="footer-badge">⚡ Always Free</span>
        </div>
      </div>

      <!-- Categories column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Categories</h3>
        <ul class="footer-links" role="list">
          {categories.map(({ href, label }) => (
            <li><a href={href} class="footer-link">{label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Filters column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Browse By</h3>
        <ul class="footer-links" role="list">
          {filters.map(({ href, label }) => (
            <li><a href={href} class="footer-link">{label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Resources column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Resources</h3>
        <ul class="footer-links" role="list">
          {resources.map(({ href, label }) => (
            <li><a href={href} class="footer-link">{label}</a></li>
          ))}
        </ul>
        <div class="footer-contact">
          <h3 class="footer-col-title" style="margin-top: 1.5rem;">Contact</h3>
          <a href="mailto:ravitejaamancha@luciddatahub.com" class="footer-link">
            Send a message
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {currentYear} AI Tools. All rights reserved.
      </p>
      <p class="footer-disclosure">
        Some links on this site are affiliate links. We may earn a small commission at no extra cost to you.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: auto;
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .footer-glow {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(ellipse at bottom center, #7C3AED15 0%, transparent 70%);
    pointer-events: none;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 3rem;
    padding: 3rem 0 2.5rem;
  }

  /* Brand */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
    text-decoration: none;
  }
  .footer-logo-mark {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: linear-gradient(135deg, #7C3AED15, #06B6D415);
    border: 1px solid #7C3AED30;
  }
  .footer-logo-name {
    font-size: 1rem;
    font-weight: 700;
    color: #F8F8F8;
    letter-spacing: -0.02em;
  }

  .footer-desc {
    font-size: 0.8125rem;
    color: #71717A;
    line-height: 1.65;
    margin-bottom: 1rem;
    max-width: 24ch;
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer-badge {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    border-radius: 6px;
    font-size: 0.6875rem;
    font-weight: 600;
    background: #1F1F2E;
    color: #A1A1AA;
    border: 1px solid #2D2D3E;
  }

  /* Columns */
  .footer-col-title {
    font-size: 0.6875rem;
    font-weight: 600;
    color: #F8F8F8;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.875rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-link {
    font-size: 0.8125rem;
    color: #71717A;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-link:hover {
    color: #A1A1AA;
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid #1F1F2E;
  }
  .footer-copy {
    font-size: 0.75rem;
    color: #52525B;
  }
  .footer-disclosure {
    font-size: 0.6875rem;
    color: #3F3F46;
    max-width: 50ch;
    text-align: right;
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-desc {
      max-width: none;
    }
  }
  @media (max-width: 639px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-disclosure {
      text-align: left;
    }
  }
</style>
