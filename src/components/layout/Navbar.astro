---
const { pathname } = Astro.url;
const isActive = (path: string) =>
  pathname === path || (path !== '/' && pathname.startsWith(path));
---

<header class="navbar" id="site-navbar">
  <div class="container-site">
    <nav class="nav-inner">
      <!-- Logo -->
      <a href="/" class="logo-link" aria-label="AI Tools — Home">
        <div class="logo-mark" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
            <defs>
              <linearGradient id="logo-grad" x1="0" y1="0" x2="28" y2="28" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#9D65F5"/>
                <stop offset="100%" stop-color="#06B6D4"/>
              </linearGradient>
            </defs>
            <path d="M14 2L26 8V20L14 26L2 20V8L14 2Z" stroke="url(#logo-grad)" stroke-width="1.5" fill="none"/>
            <path d="M14 8L20 11V17L14 20L8 17V11L14 8Z" fill="url(#logo-grad)" opacity="0.3"/>
            <circle cx="14" cy="14" r="3" fill="url(#logo-grad)"/>
          </svg>
        </div>
        <div class="logo-text">
          <span class="logo-name">AI Tools</span>
          <span class="logo-tagline">India's #1 Directory</span>
        </div>
      </a>

      <!-- Desktop nav links -->
      <ul class="nav-links" role="list">
        <li>
          <a href="/tools" class:list={['nav-link', { active: isActive('/tools') }]}>
            Tools
          </a>
        </li>
        <li>
          <a href="/reviews" class:list={['nav-link', { active: isActive('/reviews') }]}>
            Reviews
          </a>
        </li>
        <li>
          <a href="/guides" class:list={['nav-link', { active: isActive('/guides') }]}>
            Guides
          </a>
        </li>
        <li>
          <a href="/blog" class:list={['nav-link', { active: isActive('/blog') }]}>
            Blog
          </a>
        </li>
      </ul>

      <!-- CTA -->
      <div class="nav-actions">
        <a href="/search" class="nav-search-btn" aria-label="Search">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="5.25" stroke="currentColor" stroke-width="1.5"/>
            <path d="M11 11l2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="/tools" class="btn-primary nav-cta">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 1L13 7L7 13M1 7H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Browse Tools
        </a>

        <!-- Mobile menu button -->
        <button class="mobile-menu-btn" id="mobile-menu-toggle" aria-label="Toggle navigation" aria-expanded="false">
          <span class="menu-icon" id="menu-icon-bars">
            <span></span><span></span><span></span>
          </span>
          <span class="menu-icon hidden" id="menu-icon-close" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M2 2L16 16M16 2L2 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile drawer -->
  <div class="mobile-menu hidden" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation">
    <div class="container-site">
      <ul class="mobile-nav-links" role="list">
        <li><a href="/tools" class:list={['mobile-nav-link', { active: isActive('/tools') }]}>Tools</a></li>
        <li><a href="/reviews" class:list={['mobile-nav-link', { active: isActive('/reviews') }]}>Reviews</a></li>
        <li><a href="/guides" class:list={['mobile-nav-link', { active: isActive('/guides') }]}>Guides</a></li>
        <li><a href="/blog" class:list={['mobile-nav-link', { active: isActive('/blog') }]}>Blog</a></li>
        <li><a href="/about" class:list={['mobile-nav-link', { active: isActive('/about') }]}>About</a></li>
      </ul>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid #1F1F2E;
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .navbar.scrolled {
    background: rgba(9, 9, 11, 0.95);
    border-bottom-color: #2D2D3E;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 64px;
  }

  /* Logo */
  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
    text-decoration: none;
  }
  .logo-mark {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: linear-gradient(135deg, #7C3AED15, #06B6D415);
    border: 1px solid #7C3AED30;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .logo-link:hover .logo-mark {
    border-color: #7C3AED60;
    box-shadow: 0 0 12px #7C3AED30;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #F8F8F8;
    letter-spacing: -0.02em;
  }
  .logo-tagline {
    font-size: 0.625rem;
    font-weight: 500;
    color: #A1A1AA;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 1px;
  }

  /* Desktop nav links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0 auto;
  }
  .nav-link {
    padding: 0.375rem 0.875rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    color: #A1A1AA;
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .nav-link:hover {
    color: #F8F8F8;
    background: #ffffff08;
  }
  .nav-link.active {
    color: #F8F8F8;
    background: #7C3AED15;
  }

  /* Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .nav-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid #1F1F2E;
    color: #71717A;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .nav-search-btn:hover {
    border-color: #2D2D3E;
    color: #A1A1AA;
    background: #17171F;
  }
  .nav-cta {
    font-size: 0.8125rem;
    padding: 0.4375rem 1rem;
  }

  /* Mobile toggle */
  .mobile-menu-btn {
    display: none;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid #1F1F2E;
    background: transparent;
    color: #A1A1AA;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .mobile-menu-btn:hover {
    border-color: #2D2D3E;
    color: #F8F8F8;
  }
  .menu-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .menu-icon span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .hidden { display: none !important; }

  /* Mobile menu */
  .mobile-menu {
    border-top: 1px solid #1F1F2E;
    background: rgba(9, 9, 11, 0.97);
    padding: 1rem 0 1.25rem;
  }
  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .mobile-nav-link {
    display: block;
    padding: 0.75rem 0.875rem;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #A1A1AA;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: #F8F8F8;
    background: #7C3AED15;
  }

  /* Responsive */
  @media (max-width: 767px) {
    .nav-links { display: none; }
    .nav-cta { display: none; }
    .mobile-menu-btn { display: flex; }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bars = document.getElementById('menu-icon-bars');
  const close = document.getElementById('menu-icon-close');
  const navbar = document.getElementById('site-navbar');

  // Mobile menu toggle
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    if (isOpen) {
      menu?.classList.add('hidden');
      bars?.classList.remove('hidden');
      close?.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    } else {
      menu?.classList.remove('hidden');
      bars?.classList.add('hidden');
      close?.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
    }
  });

  // Scroll effect
  const onScroll = () => {
    if (window.scrollY > 10) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
