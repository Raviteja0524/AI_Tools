# Supabase — get from your project: Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# MIGRATION ONLY — NEVER add this to Vercel or any production environment
# Required to run: npm run migrate (bypasses Row Level Security for initial data load)
# Get from: Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Vercel deploy webhook — triggers a site rebuild when automation agent updates DB
# Get from: Vercel project → Settings → Git → Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
